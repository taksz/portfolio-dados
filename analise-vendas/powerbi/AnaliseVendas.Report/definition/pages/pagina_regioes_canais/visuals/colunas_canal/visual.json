{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "colunas_canal",
  "position": {
    "x": 660,
    "y": 140,
    "z": 0,
    "height": 560,
    "width": 600
  },
  "visual": {
    "visualType": "hundredPercentStackedColumnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_calendario"
                    }
                  },
                  "Property": "ano"
                }
              },
              "queryRef": "dim_calendario.ano",
              "nativeQueryRef": "ano"
            }
          ]
        },
        "Series": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_canal"
                    }
                  },
                  "Property": "canal"
                }
              },
              "queryRef": "dim_canal.canal",
              "nativeQueryRef": "canal"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Medidas"
                    }
                  },
                  "Property": "Receita Total"
                }
              },
              "queryRef": "Medidas.Receita Total",
              "nativeQueryRef": "Receita Total"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true,
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Participação de cada canal na receita, por ano'"
                }
              }
            }
          }
        }
      ]
    }
  }
}
