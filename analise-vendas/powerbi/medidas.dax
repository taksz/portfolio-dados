// Medidas DAX para o modelo estrela gerado por src/exportar_powerbi.py.
// Tabelas: fato_vendas, dim_calendario, dim_produto, dim_regiao, dim_canal.
// Como usar: no Power BI Desktop, em Modelagem > Nova medida, cole uma medida por vez
// (cada bloco abaixo começa com o nome da medida). Veja o passo a passo em ROTEIRO.md.
//
// Estas medidas são as mesmas do projeto src/gerar_projeto_pbip.py, que foi aberto no Power BI
// Desktop; os valores conferem com o README (ex.: receita total R$ 4.429.491,93, 6.655 vendas).

// --- Básicas ---------------------------------------------------------------

Receita Total = SUM ( fato_vendas[receita] )

Vendas = COUNTROWS ( fato_vendas )

Unidades Vendidas = SUM ( fato_vendas[quantidade] )

Ticket Médio = DIVIDE ( [Receita Total], [Vendas] )

// --- Inteligência de tempo (exigem dim_calendario marcada como tabela de datas) ---

Receita Ano Anterior =
CALCULATE ( [Receita Total], SAMEPERIODLASTYEAR ( dim_calendario[data] ) )

// Crescimento do último ano no contexto de filtros sobre o ano anterior. Sem filtro de ano,
// compara 2024 com 2023 (19,8%). Fica em branco quando o ano anterior não tem dados.
Crescimento YoY % =
VAR AnoAtual = MAX ( dim_calendario[ano] )
VAR ReceitaAtual = CALCULATE ( [Receita Total], dim_calendario[ano] = AnoAtual )
VAR ReceitaAnterior = CALCULATE ( [Receita Total], dim_calendario[ano] = AnoAtual - 1 )
RETURN
    DIVIDE ( ReceitaAtual - ReceitaAnterior, ReceitaAnterior )

Receita Acumulada no Ano = TOTALYTD ( [Receita Total], dim_calendario[data] )

// --- Participação e comparação ---------------------------------------------

// Quanto cada categoria/região/canal representa do total selecionado nos filtros.
Participação na Receita % =
DIVIDE ( [Receita Total], CALCULATE ( [Receita Total], ALLSELECTED () ) )

Receita Online % =
DIVIDE ( CALCULATE ( [Receita Total], dim_canal[canal] = "Online" ), [Receita Total] )

// --- Sazonalidade (novembro e dezembro, definidos em dim_calendario[alta_temporada]) ---

Receita Alta Temporada =
CALCULATE ( [Receita Total], dim_calendario[alta_temporada] = "Sim" )

// Receita média por mês dentro do contexto atual de filtros.
Receita Média Mensal =
DIVIDE ( [Receita Total], DISTINCTCOUNT ( dim_calendario[ano_mes] ) )

// Quantas vezes a receita média mensal da alta temporada supera a dos demais meses.
Efeito Alta Temporada =
VAR MediaAlta =
    CALCULATE ( [Receita Média Mensal], dim_calendario[alta_temporada] = "Sim" )
VAR MediaResto =
    CALCULATE ( [Receita Média Mensal], dim_calendario[alta_temporada] = "Não" )
RETURN
    DIVIDE ( MediaAlta, MediaResto )
